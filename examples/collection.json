      "title": "Reconciled day of samples",
      "roles": [
        "data"
      ],
      "table:primary_datetime": "event_time_utc_us",
      "table:columns": [
        {
          "name": "event_time_utc_us",
          "type": "int64",
          "unit": "us",
          "roles": [
            "coordinate"
          ],
          "opensensor:procedure": "clock"
        },
        {
          "name": "pm25_atmospheric_ug_m3",
          "type": "int32",
          "title": "PM2.5",
          "unit": "ug/m3",

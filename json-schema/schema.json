{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walkthru-earth.github.io/stac-opensensor/v0.1.0/schema.json#",
  "title": "OpenSensor Extension",
  "description": "STAC OpenSensor Extension for STAC Collections and STAC Items that describe low-cost sensor stations and their Parquet columns.",
  "type": "object",
  "required": [
    "stac_extensions",
    "type"
  ],
  "properties": {
    "stac_extensions": {
      "type": "array",
      "contains": {
        "const": "https://walkthru-earth.github.io/stac-opensensor/v0.1.0/schema.json"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "Collection",
        "Feature"
      ]
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/tableHolder"
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "properties": {
          "allOf": [
            {
              "$ref": "#/definitions/fields"
            },
            {
              "$ref": "#/definitions/tableHolder"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "Collection"
        },
        "item_assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/tableHolder"
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/fields"
        },
        {
          "$ref": "#/definitions/tableHolder"
        }
      ]
    }
  ],
  "definitions": {
    "fields": {
      "$comment": "Profile level fields, allowed at the top of a Collection and in Item properties.",
      "type": "object",
      "properties": {
        "opensensor:digest": {
          "$ref": "#/definitions/sha256"
        },
        "opensensor:family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "opensensor:primary": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "opensensor:scales": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/id"
          },
          "additionalProperties": {
            "$ref": "#/definitions/scale"
          }
        },
        "opensensor:hero": {
          "$ref": "#/definitions/id"
        },
        "opensensor:sample_interval_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "opensensor:proto_min": {
          "type": "integer",
          "minimum": 1
        }
      },
      "patternProperties": {
        "^(?!opensensor:)": {}
      },
      "additionalProperties": false
    },
    "tableHolder": {
      "$comment": "Validates OpenSensor fields inside Table extension columns wherever table:columns appears.",
      "type": "object",
      "properties": {
        "table:columns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/column"
          }
        }
      }
    },
    "column": {
      "$comment": "Column level fields, allowed inside table:columns entries.",
      "type": "object",
      "properties": {
        "opensensor:property": {
          "type": "string",
          "format": "uri"
        },
        "opensensor:procedure": {
          "type": "string",
          "minLength": 1
        },
        "opensensor:ucum": {
          "type": "string",
          "minLength": 1
        },
        "opensensor:unit_label": {
          "type": "string",
          "minLength": 1
        },
        "opensensor:field_id": {
          "type": "integer",
          "minimum": 0
        },
        "opensensor:codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/code"
          }
        },
        "opensensor:live_key": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,15}$"
        },
        "opensensor:role": {
          "type": "string",
          "enum": [
            "measurement",
            "health",
            "identity",
            "time",
            "status"
          ]
        },
        "opensensor:valid_when": {
          "$ref": "#/definitions/gate"
        },
        "opensensor:settle_s": {
          "type": "number",
          "minimum": 0
        },
        "opensensor:aggregate": {
          "type": "string",
          "enum": [
            "mean",
            "min",
            "max",
            "last",
            "sum",
            "count"
          ]
        },
        "opensensor:range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "opensensor:precision": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "opensensor:scale": {
          "$ref": "#/definitions/id"
        },
        "opensensor:derived": {
          "type": "object",
          "required": [
            "from",
            "method"
          ],
          "properties": {
            "from": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "method": {
              "$ref": "#/definitions/id"
            }
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^(?!opensensor:)": {}
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "colorHint": {
      "type": "string",
      "pattern": "^[0-9A-F]{6}$"
    },
    "label": {
      "$comment": "A plain string, or a map from language code to string.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "code": {
      "$comment": "Same shape as a Classification extension class.",
      "type": "object",
      "required": [
        "value",
        "name"
      ],
      "properties": {
        "value": {
          "type": "integer"
        },
        "name": {
          "type": "string",
          "pattern": "^[0-9A-Za-z-_]+$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "color_hint": {
          "$ref": "#/definitions/colorHint"
        },
        "nodata": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "column",
            "equals"
          ],
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "column",
            "finite"
          ],
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1
            },
            "finite": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "scale": {
      "type": "object",
      "required": [
        "source",
        "steps"
      ],
      "properties": {
        "source": {
          "type": "string",
          "format": "uri"
        },
        "unit": {
          "type": "string"
        },
        "guideline": {
          "type": "number"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "upper",
              "label"
            ],
            "properties": {
              "upper": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "label": {
                "$ref": "#/definitions/label"
              },
              "color_hint": {
                "$ref": "#/definitions/colorHint"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
